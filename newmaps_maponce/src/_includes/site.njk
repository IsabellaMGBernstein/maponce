<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title != "Home" %}{{ title }} · {% endif %}Mariano Ponce’s Letters</title>
<meta name="description" content="{{ description or 'Mapping the correspondence of Mariano Ponce, 1897–1900.' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Source+Sans+3:wght@400;600;700&display=swap">
<link rel="stylesheet" href="/assets/site/site.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">✉</span>
      <span class="brand-text"><span class="brand-title">Mariano Ponce’s Letters</span>
        <span class="brand-sub">A Cartography of the Philippine Revolution, 1897–1900</span></span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-menu">Menu</button>
    <nav class="site-menu" id="site-menu" aria-label="Main menu">
      <ul>
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>

<main id="main">
  <section class="page-intro wrap">
    {% if kicker %}<p class="kicker">{{ kicker }}</p>{% endif %}
    <h1>{{ heading or title }}</h1>
    {% for p in before %}<p{% if loop.first %} class="lede"{% endif %}>{{ p }}</p>{% endfor %}
  </section>

  {%- if map %}
  <section class="map-section" aria-label="{{ mapTitle }}">
    <div class="wrap-wide">
      <div class="map-frame">
        <iframe src="{{ map }}" title="{{ mapTitle }}" loading="lazy"></iframe>
      </div>
      <p class="map-caption">{{ mapCaption }} <a href="{{ map }}" target="_blank" rel="noopener">Open the map full screen ↗</a></p>
    </div>
  </section>
  {%- endif %}

  <section class="page-body wrap">
    {{ content | safe }}
  </section>
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-title">Mariano Ponce’s Letters</p>
      <p>A digital humanities project mapping the 244 letters Mariano Ponce wrote during the Hong Kong Junta, 1897–1900.</p>
    </div>
    <nav aria-label="Footer menu">
      <p class="footer-head">Explore</p>
      <ul>{% for item in nav %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}</ul>
    </nav>
    <div>
      <p class="footer-head">Source</p>
      <p>Mariano Ponce, <cite>Cartas sobre la revolución, 1897–1900</cite> (Manila: Bureau of Printing, 1932). University of Michigan Library Digital Collections.</p>
      <p class="small">Maps: Leaflet · Borders: Natural Earth</p>
    </div>
  </div>
  <div class="wrap footer-bottom"><p>© 2026 Isabella Bernstein · Lorem ipsum dolor sit amet.</p></div>
</footer>

<script>
  // the menu button on small screens
  const toggle = document.querySelector('.menu-toggle'), menu = document.getElementById('site-menu');
  toggle.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); menu.classList.toggle('open', open); });
</script>
</body>
</html>
