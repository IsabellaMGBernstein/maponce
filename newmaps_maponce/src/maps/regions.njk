<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<script>/* Inside the website (an iframe), the site header replaces this page's own heading. */
if (window.self !== window.top) document.documentElement.classList.add("embedded");</script>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Regions · Mariano Ponce’s Letters</title>
<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=Archivo+Narrow:wght@400;500;600&display=swap">
