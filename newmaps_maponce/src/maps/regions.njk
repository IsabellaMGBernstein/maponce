<body>
<header class="site-head">
  <h1>Mariano Ponce’s Letters: <em>1897–1900</em></h1>
  <p class="intro">Choose a region at the top left of the map to see only the letters Mariano Ponce sent there.</p>
  <div class="legend" id="legend" aria-label="Legend"></div>
</header>
<main class="layout">
  <div class="map-wrap"><div id="map" role="region" aria-label="Map of Ponce's letters to one region"></div></div>
  <aside class="panel">
    <div class="panel-head">
      <div class="panel-title"><h2 id="panel-title">Letters</h2>
        <button class="panel-toggle" id="panel-toggle" aria-expanded="true" aria-controls="panel-body" aria-label="Minimize the side panel" title="Minimize the side panel">–</button></div>
      <div class="panel-meta" id="panel-meta"></div>
      <label class="check"><input type="checkbox" id="inferred" checked> Include inferred destinations</label>
    </div>
    <div class="panel-body" id="panel-body"></div>
  </aside>
</main>
<section class="statbar" id="statbar" aria-label="Statistics for the region"></section>
<script src="/vendor/leaflet/leaflet.js"></script>
